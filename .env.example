# ARC Assistant Third-Party API Keys
# Gemini & Gemini Live use Firebase AI Logic (App Check) — no GEMINI_API_KEY needed.
# Configure actual values in AI Studio's Secrets panel (never commit real keys).

# ElevenLabs HD voice synthesis for typed/vision replies & Live fallback (Brian / Daniel / Adam)
ELEVENLABS_API_KEY=MY_ELEVENLABS_API_KEY

# Anthropic Claude API for secondary complex reasoning layer
ANTHROPIC_API_KEY=MY_ANTHROPIC_API_KEY

# YouTube Data API v3 for direct "play" video resolution
YOUTUBE_API_KEY=MY_YOUTUBE_API_KEY

# GNews / NewsAPI key for Morning Briefing & news headlines
NEWS_API_KEY=MY_NEWS_API_KEY

# CricAPI key for live cricket scores
CRIC_API_KEY=MY_CRIC_API_KEY
